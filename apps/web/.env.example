DATABASE_URL=postgresql://scorelineiq:changeme@localhost:5433/scorelineiq
PREDICTION_API_URL=http://localhost:8000
FOOTBALL_DATA_API_TOKEN=

# Used by sitemap.xml/robots.txt to build absolute URLs. Defaults to
# the production domain if unset — override locally if you need to
# verify the sitemap's actual output.
SITE_URL=http://localhost:3000

# Used by score-results/generate-predictions to trigger on-demand ISR
# revalidation after writing new data, instead of waiting for a page's
# time-based revalidate window. Both optional — jobs skip the call
# (falling back to time-based ISR) if either is unset.
WEB_APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# Optional — jobs run fine without it (errors just log to console).
# When set, job failures are also reported to Sentry.
SENTRY_DSN=

# Optional — the site renders fine without it, just with no analytics
# script. Leave unset locally so dev/test traffic doesn't pollute
# production analytics; set it only in the production environment.
GA_MEASUREMENT_ID=

# Optional — the AdSense site-verification/ad-loader script only loads
# when this is set. Leave unset locally.
ADSENSE_CLIENT_ID=

# Powers the homepage's "Live now" widget (lib/livescore.ts) via
# RapidAPI's "free-football-api-data" (free-football-api-data.p.
# rapidapi.com), a separate Sofascore-data mirror kept deliberately
# independent of the Football-Data.org-based prediction pipeline — it
# has no standings endpoint on the free tier and a different team/
# league ID space, so it's display-only, never a prediction input.
RAPIDAPI_FOOTBALL_STATS_KEY=

# Required to use /admin (manual prediction tool). Pick a long random
# password — the admin session cookie is a SHA-256 hash of this value,
# never the plaintext, but anyone with it can log in, so treat it like
# any other production secret.
ADMIN_PASSWORD=

# Where uploaded accumulator-post screenshots are written, relative to
# this app's cwd. Must live under public/ so Next's standalone server
# serves it directly with no custom route — in Docker this is
# hardcoded to an absolute path instead (see infra/docker-compose.yml)
# since the container's cwd differs from local dev's.
UPLOADS_DIR=./public/uploads
