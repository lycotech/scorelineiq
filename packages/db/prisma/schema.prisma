generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  externalId String  @unique
  teams     Team[]
  fixtures  Fixture[]
  accuracyStats AccuracyStat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  externalId    String   @unique
  leagueId      String
  league        League   @relation(fields: [leagueId], references: [id])
  homeFixtures  Fixture[] @relation("HomeTeam")
  awayFixtures  Fixture[] @relation("AwayTeam")

  // Current-season standings snapshot, refreshed weekly by
  // sync-teams-and-form. Nullable because a team ingested from a
  // fixture has no standings data until that job has run for its
  // league at least once. Football-Data.org's free tier only exposes
  // the TOTAL table (no home/away split) and often leaves `form` null.
  played             Int?
  won                Int?
  draw               Int?
  lost               Int?
  goalsFor           Int?
  goalsAgainst       Int?
  points             Int?
  form               String?
  standingsUpdatedAt DateTime?

  // Updated incrementally by score-results the first time each of this
  // team's fixtures is scored (never retroactively re-applied on
  // re-runs — see that job for the guard). All teams start at the
  // standard 1500 baseline since we have no prior rating history.
  eloRating Float @default(1500)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leagueId])
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model Fixture {
  id           String        @id @default(cuid())
  externalId   String        @unique
  slug         String        @unique
  leagueId     String
  league       League        @relation(fields: [leagueId], references: [id])
  homeTeamId   String
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffAt    DateTime
  status       FixtureStatus @default(SCHEDULED)
  prediction   Prediction?
  result       Result?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([leagueId])
  @@index([kickoffAt])
}

model Prediction {
  id                String   @id @default(cuid())
  fixtureId         String   @unique
  fixture           Fixture  @relation(fields: [fixtureId], references: [id])
  homeWinProbability Float
  drawProbability    Float
  awayWinProbability Float
  predictedScoreHome Int
  predictedScoreAway Int
  over25Probability  Float
  bttsProbability    Float
  // Nullable: rows written before this field existed won't have it
  // until generate-predictions re-runs and upserts them — never
  // backfilled with a guessed value.
  expectedGoals      Float?
  confidence         Float
  modelVersion       String
  generatedAt        DateTime @default(now())

  @@index([fixtureId])
}

enum ResultOutcome {
  HOME_WIN
  DRAW
  AWAY_WIN
}

model Result {
  id           String        @id @default(cuid())
  fixtureId    String        @unique
  fixture      Fixture       @relation(fields: [fixtureId], references: [id])
  homeScore    Int
  awayScore    Int
  outcome      ResultOutcome
  scoredAt     DateTime      @default(now())

  @@index([fixtureId])
}

model AccumulatorPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  imagePath   String
  imageWidth  Int
  imageHeight Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model AccuracyStat {
  id          String   @id @default(cuid())
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id])
  market      String
  windowLabel String
  totalCount  Int
  hitCount    Int
  hitRate     Float
  computedAt  DateTime @default(now())

  // Always scoped to a league — an "overall across all leagues" figure
  // is computed at read time (Phase 3) from these rows rather than
  // stored as a leagueId-null row: Postgres treats NULL as distinct in
  // unique constraints, which would break upsert-based idempotency here.
  @@unique([leagueId, market, windowLabel])
}
