{
  "name": "scorelineiq",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/db"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "db:generate": "npm run generate --workspace=@scorelineiq/db",
    "db:migrate": "npm run migrate:dev --workspace=@scorelineiq/db"
  }
}
