POSTGRES_PASSWORD=changeme

# Passed into the web container's environment (docker-compose.yml) so
# the running server can verify on-demand revalidation requests from
# score-results/generate-predictions. Must match the value in
# apps/web/.env exactly, or /api/revalidate rejects every call with 401
# and silently falls back to each page's time-based revalidate window.
REVALIDATE_SECRET=

# Optional — same value as apps/web/.env's SENTRY_DSN, if set.
SENTRY_DSN=

# Optional — same values as apps/web/.env's, if set. Neither is a
# secret (both end up in public page source by design), but they're
# still env-gated so local/dev traffic never reports into production
# analytics or ad accounts.
GA_MEASUREMENT_ID=
ADSENSE_CLIENT_ID=

# Not used by any app/job — held for ad-hoc DNS management via the
# Cloudflare API (e.g. updating A records if the VPS IP ever changes).
# Scoped to the scorelineiq.com zone only.
CLOUDFLARE_API_TOKEN=
